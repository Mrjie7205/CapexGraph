# Optional official OpenAI API channel. Golden fixtures and research preparation need no key.
OPENAI_API_KEY=
# Preferred per-channel model setting. CAPEXGRAPH_MODEL remains a legacy OpenAI-only fallback.
CAPEXGRAPH_OPENAI_MODEL=
CAPEXGRAPH_MODEL=

# Optional personal Codex subscription channel through the official local Codex CLI.
# Login is managed by Codex/ChatGPT; CapexGraph never receives OAuth tokens.
CAPEXGRAPH_CODEX_TRANSPORT=cli
CAPEXGRAPH_CODEX_CLI_PATH=
CAPEXGRAPH_CODEX_MODEL=
CAPEXGRAPH_CODEX_TIMEOUT_SECONDS=180
# Advanced compatibility path for an existing CLIProxyAPI deployment. Not required by default.
CAPEXGRAPH_CODEX_BASE_URL=http://127.0.0.1:8317/v1
CAPEXGRAPH_CODEX_PROXY_KEY=
# Keep disabled unless the operator has intentionally secured a remote proxy.
CAPEXGRAPH_ALLOW_REMOTE_CODEX_PROXY=0

# Optional licensed cross-market daily history. Yahoo remains the no-key fallback.
EODHD_API_TOKEN=
CAPEXGRAPH_MARKET_PROVIDER=yahoo

# Optional Jin10 live-event channels. MCP and WebSocket run independently at equal priority.
# Connection Center submits credentials once to the local backend; values are never returned.
JIN10_MCP_BEARER_TOKEN=
JIN10_WEBSOCKET_SECRET_KEY=
CAPEXGRAPH_JIN10_MCP_ENABLED=1
CAPEXGRAPH_JIN10_WEBSOCKET_ENABLED=1
CAPEXGRAPH_JIN10_MCP_TIMEOUT_SECONDS=20
# Local target guard; Jin10's documented per-tool hard limit is 1500/day (Beijing time).
CAPEXGRAPH_JIN10_MCP_CALL_BUDGET=1200
CAPEXGRAPH_JIN10_WS_FLASH_CATEGORIES=1,4
CAPEXGRAPH_JIN10_WS_CALENDAR_CATEGORIES=cj
# Leave blank until quote subscriptions are explicitly enabled in Live Desk.
CAPEXGRAPH_JIN10_WS_QUOTE_CATEGORIES=

# SEC requests should identify your application and include a real contact method.
CAPEXGRAPH_SEC_USER_AGENT=CapexGraph research your-name your-email@example.com

CAPEXGRAPH_RUNS_DIR=runs
# Optional CSV that extends the bundled ticker identity registry.
CAPEXGRAPH_TICKER_FILE=
# Keep disabled unless you intentionally capture an internal source.
CAPEXGRAPH_ALLOW_PRIVATE_URLS=0
# Optional override. Defaults to <runs-dir>/capexgraph.db.
CAPEXGRAPH_STATE_DB=
CAPEXGRAPH_LOG_LEVEL=INFO
