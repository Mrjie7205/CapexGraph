# One LLM provider is enough for the future agent runtime.
# The scaffold does not call a model yet.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional premium market data. Free providers remain the default path.
EODHD_API_KEY=

CAPEXGRAPH_RUNS_DIR=runs
# Optional override. Defaults to <runs-dir>/capexgraph.db.
CAPEXGRAPH_STATE_DB=
CAPEXGRAPH_LOG_LEVEL=INFO
